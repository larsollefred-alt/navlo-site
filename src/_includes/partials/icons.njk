{% macro icon(name, size=48) %}
<svg class="icon icon--{{ name }}" viewBox="0 0 48 48" width="{{ size }}" height="{{ size }}" aria-hidden="true" focusable="false">
{%- if name == "page" -%}
  <rect x="10" y="6" width="28" height="36" rx="3" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <path stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="M16 15h16M16 22h16M16 29h10"/>
{%- elif name == "pages" -%}
  <rect x="14" y="4" width="26" height="32" rx="3" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" d="M8 12v29a3 3 0 0 0 3 3h21"/>
  <path stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="M20 13h14M20 20h14M20 27h9"/>
{%- elif name == "server" -%}
  <rect x="6" y="7" width="36" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <rect x="6" y="27" width="36" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <circle cx="14" cy="14" r="2" fill="currentColor"/><circle cx="14" cy="34" r="2" fill="currentColor"/>
{%- elif name == "star" -%}
  <path fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" d="m24 6 5.5 11.2 12.3 1.8-8.9 8.7 2.1 12.3L24 34.2 13 40l2.1-12.3-8.9-8.7 12.3-1.8L24 6Z"/>
{%- elif name == "bolt" -%}
  <path fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" d="M27 5 11 27h11l-2 16 17-23H26l1-15Z"/>
{%- elif name == "shield" -%}
  <path fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" d="M24 5 8 11v11c0 10 7 17.5 16 21 9-3.5 16-11 16-21V11L24 5Z"/>
{%- elif name == "check" -%}
  <path fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" d="m10 25 9 9 19-20"/>
{%- elif name == "chart" -%}
  <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M6 40h36M10 32l9-9 7 6 14-15M32 14h8v8"/>
{%- elif name == "pin" -%}
  <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" d="M24 43s14-12.4 14-24a14 14 0 1 0-28 0c0 11.6 14 24 14 24Z"/>
  <circle cx="24" cy="19" r="5" fill="none" stroke="currentColor" stroke-width="2.5"/>
{%- elif name == "search" -%}
  <circle cx="21" cy="21" r="13" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <path stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="m31 31 11 11"/>
{%- elif name == "speed" -%}
  <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="M7 34a17 17 0 1 1 34 0M24 34l8-10"/>
  <circle cx="24" cy="34" r="2.5" fill="currentColor"/>
{%- elif name == "form" -%}
  <rect x="9" y="5" width="30" height="38" rx="4" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="M16 16h16M16 24h16M16 32h9"/>
{%- elif name == "pen" -%}
  <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" d="m31 7 10 10L17 41H7V31L31 7Z"/>
  <path stroke="currentColor" stroke-width="2.5" d="m26 12 10 10"/>
{%- elif name == "chat" -%}
  <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" d="M8 10h32a2 2 0 0 1 2 2v20a2 2 0 0 1-2 2H22l-9 7v-7H8a2 2 0 0 1-2-2V12a2 2 0 0 1 2-2Z"/>
  <path stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="M15 20h18M15 26h11"/>
{%- elif name == "code" -%}
  <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m16 14-10 10 10 10M32 14l10 10-10 10M27 9l-6 30"/>
{%- elif name == "rocket" -%}
  <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" d="M24 4c7 5 10 13 8 24h-16C14 17 17 9 24 4Z"/>
  <circle cx="24" cy="17" r="3.5" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" d="m16 24-6 6v6l7-4M32 24l6 6v6l-7-4M20 34h8l-4 9-4-9Z"/>
{%- elif name == "check-circle" -%}
  <circle cx="24" cy="24" r="18" fill="none" stroke="currentColor" stroke-width="2.5"/>
  <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="m16 24 6 6 11-12"/>
{%- elif name == "arrow" -%}
  <path fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="M12 24h24M26 14l10 10-10 10"/>
{%- elif name == "quote" -%}
  <path fill="currentColor" d="M6 38V26c0-9 4.5-15.3 13-18l2 4c-5 2-7.6 5.4-8 10h7v16H6Zm22 0V26c0-9 4.5-15.3 13-18l2 4c-5 2-7.6 5.4-8 10h7v16H28Z"/>
{%- endif -%}
</svg>
{% endmacro %}
